{
  "name": "bbgddg",
  "version": "1.2.3",
  "description": "BBGDDG · 中文深色 PDF 阅读、笔记与 AI 研究工作台",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "bin": {
    "bbgddg": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "frontend/dist/",
    "skills/",
    "scripts/install-skill.sh",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build --workspace frontend",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts serve --no-open",
    "start": "node dist/cli/index.js",
    "pretest": "npm run build:server",
    "test:raw": "node scripts/run-tests.mjs",
    "test": "c8 --all --include=src/core/**/*.ts --include=src/server/**/*.ts --include=src/cli/**/*.ts --exclude=src/**/*.d.ts --check-coverage --lines 70 --statements 70 --functions 60 --branches 55 npm run test:raw",
    "test:coverage": "c8 --all --reporter=text --reporter=html --include=src/core/**/*.ts --include=src/server/**/*.ts --include=src/cli/**/*.ts npm run test:raw",
    "test:watch": "tsx --test --watch test/**/*.test.ts",
    "test:e2e": "npm run build && npm exec --workspace frontend playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "skill:install": "bash scripts/install-skill.sh",
    "skill:uninstall": "bash scripts/install-skill.sh --uninstall",
    "test:security": "node --import tsx --test test/unit/ai-secrets.test.ts test/unit/agents.test.ts test/integration/local-access.test.ts test/integration/ai-api.test.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^9.3.0",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "fastify": "^5.4.0",
    "fflate": "^0.8.3",
    "open": "^10.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^5.4.54",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.1",
    "c8": "^11.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  },
  "author": "BBGDDG contributors",
  "private": true
}
